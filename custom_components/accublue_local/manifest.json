{
  "domain": "accublue_local",
  "name": "AccuBlue Local",
  "bluetooth": [
    {
      "local_name": "AccuBlueHome*",
      "connectable": true
    }
  ],
  "codeowners": ["@Rake-Pro"],
  "config_flow": true,
  "dependencies": ["bluetooth_adapters"],
  "documentation": "https://github.com/Rake-Pro/homeassistant-accublue",
  "integration_type": "device",
  "iot_class": "local_polling",
  "issue_tracker": "https://github.com/Rake-Pro/homeassistant-accublue/issues",
  "loggers": ["bleak", "bleak_retry_connector"],
  "requirements": ["bleak-retry-connector>=3.6.0"],
  "version": "0.1.0"
}
